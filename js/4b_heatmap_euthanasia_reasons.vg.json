{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heat map (Kirk 2019), two panels for dogs and cats: share of each state's euthanased animals by reason, 2024-25. Cells are not labelled, because a heat map is for spotting patterns; exact values are in the tooltip. Single-hue slate scale.",
  "data": {
    "url": "data/rspca_euthanasia_reasons_2024_25.csv",
    "format": {
      "type": "csv",
      "parse": {
        "count": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "state_total"
        }
      ],
      "groupby": [
        "state",
        "species"
      ]
    },
    {
      "calculate": "datum.state_total > 0 ? datum.count / datum.state_total : 0",
      "as": "share"
    },
    {
      "calculate": "datum.state + ' (' + format(datum.state_total, ',.0f') + ')'",
      "as": "state_label"
    }
  ],
  "facet": {
    "column": {
      "field": "species",
      "type": "nominal",
      "title": null,
      "sort": [
        "Dogs",
        "Cats"
      ],
      "header": {
        "labelAnchor": "start"
      }
    }
  },
  "spacing": 48,
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spec": {
    "width": 400,
    "height": 280,
    "encoding": {
      "x": {
        "field": "reason",
        "type": "nominal",
        "title": null,
        "sort": [
          "Behavioural",
          "Medical",
          "Infectious",
          "Legal",
          "Other"
        ],
        "axis": {
          "orient": "top",
          "labelAngle": 0,
          "domain": false,
          "ticks": false,
          "labelFontWeight": 600
        }
      },
      "y": {
        "field": "state_label",
        "type": "nominal",
        "title": "State (animals put to sleep)",
        "sort": {
          "field": "state_total",
          "op": "max",
          "order": "descending"
        },
        "axis": {
          "domain": false,
          "ticks": false
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "rect",
          "stroke": "#FFFFFF",
          "strokeWidth": 2,
          "cornerRadius": 2
        },
        "encoding": {
          "color": {
            "field": "share",
            "type": "quantitative",
            "title": "Share of that state's losses",
            "scale": {
              "domain": [
                0,
                0.25,
                0.5,
                0.75,
                1
              ],
              "range": [
                "#EEF1F4",
                "#C3CDD6",
                "#8A9BAA",
                "#4C6276",
                "#002133"
              ]
            },
            "legend": {
              "format": ".0%",
              "orient": "bottom",
              "direction": "horizontal",
              "gradientLength": 320,
              "titleLimit": 400,
              "labelFontSize": 13,
              "titleFontSize": 13
            }
          },
          "tooltip": [
            {
              "field": "state_name",
              "type": "nominal",
              "title": "State"
            },
            {
              "field": "species",
              "type": "nominal",
              "title": "Animal"
            },
            {
              "field": "reason",
              "type": "nominal",
              "title": "Reason"
            },
            {
              "field": "count",
              "type": "quantitative",
              "title": "Animals put to sleep",
              "format": ",.0f"
            },
            {
              "field": "share",
              "type": "quantitative",
              "title": "Share of state total",
              "format": ".0%"
            }
          ]
        }
      }
    ]
  }
}