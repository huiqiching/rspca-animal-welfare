{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope graph (Kirk 2019): share of animals put to sleep in 2020-21 vs 2024-25 by group. Each group keeps its page-wide colour; dogs are emphasised with a thicker line because theirs is the only rate that rose.",
  "width": "container",
  "height": 280,
  "padding": {
    "left": 44,
    "right": 8,
    "top": 10
  },
  "data": {
    "url": "data/rspca_national_trend_5yr.csv",
    "format": {
      "type": "csv",
      "parse": {
        "pct_euthanased": "number",
        "euthanased": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.fin_year == '2020-21' || datum.fin_year == '2024-25'"
    },
    {
      "calculate": "datum.species_group == 'Dogs' || datum.species_group == 'Cats' ? datum.species_group : 'Wildlife & other'",
      "as": "group"
    },
    {
      "calculate": "datum.pct_euthanased / 100",
      "as": "rate"
    },
    {
      "calculate": "datum.fin_year == '2020-21' ? 0 : 1",
      "as": "xpos"
    }
  ],
  "encoding": {
    "x": {
      "field": "xpos",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          -0.04,
          1.62
        ],
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [
          0,
          1
        ],
        "labelExpr": "datum.value == 0 ? '2020-21' : '2024-25'",
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "grid": false,
        "labelFontWeight": 700,
        "labelFontSize": 15,
        "labelPadding": 10
      }
    },
    "y": {
      "field": "rate",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          0.6
        ]
      },
      "axis": null
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Cats",
          "Wildlife & other",
          "Dogs"
        ],
        "range": [
          "#0085CA",
          "#3B7F2A",
          "#F5A01A"
        ]
      },
      "legend": null
    },
    "detail": {
      "field": "group"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line"
      },
      "encoding": {
        "strokeWidth": {
          "condition": {
            "test": "datum.group == 'Dogs'",
            "value": 4
          },
          "value": 2
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "fin_year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "euthanased",
            "type": "quantitative",
            "title": "Put to sleep",
            "format": ",.0f"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Share put to sleep",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.fin_year == '2020-21'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "fontWeight": 600,
        "fontSize": 15
      },
      "encoding": {
        "text": {
          "field": "rate",
          "format": ".0%"
        },
        "color": {
          "value": "#2D333D"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.fin_year == '2024-25'"
        },
        {
          "calculate": "format(datum.rate, '.0%') + '  ' + datum.group",
          "as": "label"
        },
        {
          "calculate": "datum.group == 'Dogs' ? datum.rate - 0.015 : datum.group == 'Cats' ? datum.rate + 0.015 : datum.rate",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontWeight": 600,
        "fontSize": 15
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#2D333D"
        }
      }
    }
  ]
}
