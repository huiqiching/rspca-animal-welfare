{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line chart: animals received by the RSPCA nationally each financial year, 2020-21 to 2024-25, by animal group. Lines are labelled directly at their ends instead of using a legend (course notes: direct labelling). Group is shown by colour plus a direct label only (no redundant shape encoding).",
  "width": "container",
  "height": 280,
  "padding": {
    "right": 120,
    "top": 10
  },
  "data": {
    "url": "data/rspca_national_trend_5yr.csv",
    "format": {
      "type": "csv",
      "parse": {
        "total_received": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.species_group == 'Dogs' || datum.species_group == 'Cats' ? datum.species_group : 'Wildlife & other'",
      "as": "group"
    }
  ],
  "encoding": {
    "x": {
      "field": "fin_year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "total_received",
      "type": "quantitative",
      "title": "Animals arriving",
      "scale": {
        "domain": [
          0,
          45000
        ]
      },
      "axis": {
        "format": ",.0f",
        "tickCount": 4,
        "domain": false,
        "ticks": false
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Cats",
          "Wildlife & other",
          "Dogs"
        ],
        "range": [
          "#0085CA",
          "#3B7F2A",
          "#F5A01A"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3.5
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "fin_year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "total_received",
            "type": "quantitative",
            "title": "Animals arriving",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.fin_year == '2024-25'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontWeight": 700,
        "fontSize": 13,
        "color": "#2D333D"
      },
      "encoding": {
        "text": {
          "field": "group"
        },
        "color": {
          "value": "#2D333D"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.fin_year == '2020-21' && datum.group == 'Cats'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -16,
        "fontSize": 12,
        "fontStyle": "italic"
      },
      "encoding": {
        "text": {
          "value": "Cats: down 40% in five years"
        },
        "color": {
          "value": "#5D646E"
        }
      }
    }
  ]
}
